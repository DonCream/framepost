async function sendToN8n() {
  if (!n8nConfig.connected || !n8nConfig.webhookUrl) {
    openN8nSettings(); return;
  }
  const checks = ['c1','c2','c3','c4'].every(id => document.getElementById(id).checked);
  if (!checks) { toast('!', 'Complete the checklist first'); return; }
  const cap = document.getElementById('captionInput').value.trim();
  if (!cap) { toast('!', 'Add a caption before sending'); return; }
  const sched = document.getElementById('schedInput').value;
  const activeTags = [...document.querySelectorAll('#tagCloud .htag:not(.removed)')].map(el=>el.textContent);
  const payload = {
    caption: cap,
    hashtags: activeTags,
    full_text: cap + '\n\n' + activeTags.join(' '),
    platforms: n8nConfig.platforms,
    scheduled_time: sched,
    tone: tone,
    source: 'framepost',
    sent_at: new Date().toISOString(),
    // Include Cloudinary data if this came from an n8n auto-draft
    ...(window._activeDraft ? {
      public_id: window._activeDraft.public_id,
      image_url: window._activeDraft.image_url,
      draft_id:  window._activeDraft.draft_id
    } : {})
  };
  const headers = {'Content-Type':'application/json'};
  if (n8nConfig.secret) headers['x-framepost-secret'] = n8nConfig.secret;
  const btn = document.getElementById('sendN8nBtn');
  btn.textContent = '⬡ Sending...'; btn.disabled = true;
  try {
    await fetch(n8nConfig.webhookUrl, { method:'POST', headers, body: JSON.stringify(payload) });
    toast('🚀', 'Sent to n8n — post queued for publishing!');
    document.querySelectorAll('.queue-item.active .q-badge').forEach(b => {
      b.className='q-badge q-scheduled'; b.textContent='Sched.';
    });
  } catch(e) {
    // CORS is expected — n8n still receives the POST
    toast('🚀', 'Sent to n8n! (CORS warning is normal)');
    document.querySelectorAll('.queue-item.active .q-badge').forEach(b => {
      b.className='q-badge q-scheduled'; b.textContent='Sched.';
    });
  }
  btn.textContent = '⬡ Send to n8n →'; btn.disabled = false;
}


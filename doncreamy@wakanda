    reel_30:'30-second Instagram/Facebook Reel (fast cuts, voiceover or text overlays)',
    reel_60:'60-second Instagram/Facebook Reel (story arc, interview-style pacing)',
    story_3:'3-slide Instagram/Facebook Story sequence',
    story_5:'5-slide Instagram/Facebook Story sequence with tips or reveal'
  };
  setSpinner('reelSpinner', true);
  const out = document.getElementById('scriptOutput');
  out.classList.remove('empty');
  out.textContent = '';
  try {
    scriptText = await aiRequest('reels',
      `Write a ${formatLabels[reelFormat]} script for a ${genre} photographer based in Detroit.
Topic: "${topic}"
Mood: ${reelMood}
The photographer's style is humanistic, honest, and cinematic — real people, real moments.
Format the script clearly with timing cues, visual directions, and text/voiceover. Make it feel like a real working script.

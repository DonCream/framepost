// ── UNIFIED AI REQUEST ──
// task = 'caption' | 'hashtags' | 'reels' | 'ideas'
// prompt = string
// returns the text response string
async function aiRequest(task, prompt) {
  if (!aiConfig.provider) throw new Error('No AI provider configured. Click the model badge to set one up.');

  if (aiConfig.provider === 'openrouter') {
    // ── OpenRouter: OpenAI-compatible chat completions ──
    if (!aiConfig.orApiKey) throw new Error('OpenRouter API key not set.');
    const model = aiConfig.orModels[task];
    const res = await fetch('https://openrouter.ai/api/v1/chat/completions', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${aiConfig.orApiKey}`,
        'HTTP-Referer': 'https://framepost.app',
        'X-Title': 'FramePost'
      },
      body: JSON.stringify({
        model,
        max_tokens: task === 'reels' ? 1200 : task === 'ideas' ? 1400 : 800,
        messages: [{ role: 'user', content: prompt }]
      })
    });
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      throw new Error(`OpenRouter error ${res.status}: ${err?.error?.message || res.statusText}`);
    }
    const d = await res.json();
    return d.choices?.[0]?.message?.content || '';

  } else if (aiConfig.provider === 'ollama') {
    // ── Ollama: local /api/chat (OpenAI-compatible) ──
    const model = aiConfig.olModels[task];
    const base = aiConfig.ollamaUrl.replace(/\/$/, '');
    const res = await fetch(`${base}/api/chat`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model,
        stream: false,
        messages: [{ role: 'user', content: prompt }]
      })
    });
    if (!res.ok) throw new Error(`Ollama error ${res.status}. Is Ollama running? Try: OLLAMA_ORIGINS=* ollama serve`);
    const d = await res.json();
    return d.message?.content || '';
  }

  throw new Error('Unknown provider.');
}


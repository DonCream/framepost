// ── UNIFIED AI REQUEST → routes everything through n8n AI broker ──
// n8n receives {task, prompt, provider, model}, calls Ollama or OpenRouter, returns {result}
async function aiRequest(task, prompt) {
  const brokerUrl = aiConfig.brokerUrl;
  if (!brokerUrl) {
    throw new Error('n8n AI broker URL not set. Click the model badge → configure.');
  }
  const provider = aiConfig.provider || 'ollama';
  const model = provider === 'openrouter'
    ? aiConfig.orModels[task]
    : aiConfig.olModels[task];

  const headers = { 'Content-Type': 'application/json' };
  if (aiConfig.brokerSecret) headers['x-framepost-secret'] = aiConfig.brokerSecret;

  const res = await fetch(brokerUrl, {
    method: 'POST',
    headers,
    body: JSON.stringify({ task, prompt, provider, model, source: 'framepost' })
  });

  if (!res.ok) {
    const err = await res.json().catch(() => ({}));
    throw new Error(`n8n broker error ${res.status}: ${err?.error || res.statusText}`);
  }
  const d = await res.json();
  // n8n responds with { result: "..." }
  return d.result || d.text || d.content || '';
}


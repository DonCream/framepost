const DAY_SHORT  = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const WEEKEND    = [0, 6];

// Default schedule: Wed 7PM, Thu 6:30PM, Fri 11AM, Sat 10AM

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FramePost Pro</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Archivo:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ink:#0f0e0c;
  --ink2:#2a2925;
  --ink3:#47453f;
  --surface:#f5f2ec;
  --surface2:#ede9e0;
  --surface3:#e3ddd1;
  --surface4:#d8d1c3;
  --border:rgba(15,14,12,0.1);
  --border2:rgba(15,14,12,0.18);
  --border3:rgba(15,14,12,0.28);
  --cream:#faf8f3;
  --rust:#b84c2a;
  --rust-lt:#f0d5cb;
  --rust-bg:rgba(184,76,42,0.08);
  --teal:#2a7a6f;
  --teal-lt:#c8e8e4;
  --teal-bg:rgba(42,122,111,0.08);
  --amber:#c97a1a;
  --amber-bg:rgba(201,122,26,0.09);
  --fg-muted:#6b6860;
  --fg-faint:#9b978f;
  --radius:10px;
  --radius-sm:6px;
  --shadow:0 1px 3px rgba(15,14,12,0.08), 0 4px 16px rgba(15,14,12,0.06);
}

body{
  font-family:'Archivo',sans-serif;
  background:var(--surface);
  color:var(--ink);
  min-height:100vh;
  display:flex;
  flex-direction:column;
  font-size:14px;
}

/* ── HEADER ── */
header{
  background:var(--cream);
  border-bottom:1px solid var(--border2);
  padding:0 28px;
  display:flex;
  align-items:center;
  height:54px;
  gap:0;
  position:sticky;top:0;z-index:200;
}
.logo{
  font-family:'Playfair Display',serif;
  font-size:19px;
  letter-spacing:-0.3px;
  color:var(--ink);
  flex-shrink:0;
  margin-right:28px;
}
.logo em{color:var(--rust);font-style:italic;}
.nav{display:flex;gap:0;height:100%;}
.nav-btn{
  height:100%;padding:0 18px;border:none;background:none;
  font-family:'Archivo',sans-serif;font-size:13px;font-weight:500;
  color:var(--fg-muted);cursor:pointer;position:relative;
  border-bottom:2px solid transparent;transition:color 0.15s;
  white-space:nowrap;
}
.nav-btn:hover{color:var(--ink);}
.nav-btn.active{color:var(--ink);border-bottom-color:var(--rust);}
.header-right{margin-left:auto;display:flex;align-items:center;gap:12px;}
.ai-badge{
  font-size:11px;font-weight:600;
  background:var(--rust-bg);color:var(--rust);
  border:1px solid rgba(184,76,42,0.2);
  padding:4px 10px;border-radius:20px;
  display:flex;align-items:center;gap:5px;
}
.model-badge{
  font-size:11px;font-weight:600;
  background:var(--amber-bg);color:var(--amber);
  border:1px solid rgba(201,122,26,0.22);
  padding:4px 10px;border-radius:20px;
  display:flex;align-items:center;gap:5px;cursor:pointer;
  transition:background 0.15s;
}
.model-badge:hover{background:rgba(201,122,26,0.15);}
.model-dot{width:6px;height:6px;border-radius:50%;background:var(--fg-faint);}
.model-dot.openrouter{background:#7c5cbf;animation:blink 2s infinite;}
.model-dot.ollama{background:var(--teal);animation:blink 2s infinite;}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0.3}}
.n8n-badge{
  font-size:11px;font-weight:600;
  background:var(--teal-bg);color:var(--teal);
  border:1px solid rgba(42,122,111,0.2);
  padding:4px 10px;border-radius:20px;
  display:flex;align-items:center;gap:5px;cursor:pointer;
  transition:background 0.15s;
}
.n8n-badge:hover{background:rgba(42,122,111,0.14);}
.n8n-badge .n8n-dot{width:6px;height:6px;border-radius:50%;background:var(--teal);}
.n8n-dot.connected{animation:blink 2s infinite;}
.n8n-dot.disconnected{background:var(--fg-faint);}

.sched-badge{
  font-size:11px;font-weight:600;
  background:rgba(42,122,111,0.08);color:var(--teal);
  border:1px solid rgba(42,122,111,0.2);
  padding:4px 10px;border-radius:20px;
  display:flex;align-items:center;gap:5px;cursor:pointer;
  transition:background 0.15s;
}
.sched-badge:hover{background:rgba(42,122,111,0.14);}
.sched-badge-icon{font-size:12px;}

/* ── N8N MODAL ── */
.modal-overlay{
  position:fixed;inset:0;background:rgba(15,14,12,0.5);
  z-index:500;display:none;align-items:center;justify-content:center;
  backdrop-filter:blur(2px);
}
.modal-overlay.open{display:flex;}
.modal{
  background:var(--cream);border:1px solid var(--border2);
  border-radius:14px;width:520px;max-width:95vw;
  box-shadow:0 24px 64px rgba(15,14,12,0.2);
  overflow:hidden;
}
.modal-header{
  padding:18px 22px 16px;border-bottom:1px solid var(--border);
  display:flex;align-items:flex-start;justify-content:space-between;
}
.modal-header h2{font-family:'Playfair Display',serif;font-size:20px;}
.modal-header p{font-size:12px;color:var(--fg-muted);margin-top:3px;line-height:1.5;}
.modal-close{background:none;border:none;font-size:18px;cursor:pointer;color:var(--fg-muted);padding:2px 6px;border-radius:4px;}
.modal-close:hover{background:var(--surface2);}
.modal-body{padding:20px 22px;display:flex;flex-direction:column;gap:16px;}
.modal-footer{padding:14px 22px;border-top:1px solid var(--border);display:flex;gap:10px;justify-content:flex-end;}
.field-group{display:flex;flex-direction:column;gap:6px;}
.field-group label{font-size:11px;font-weight:600;letter-spacing:0.7px;text-transform:uppercase;color:var(--fg-faint);}
.field-group input,.field-group select{
  background:var(--surface2);border:1px solid var(--border2);
  border-radius:var(--radius-sm);color:var(--ink);font-family:'Archivo',sans-serif;
  font-size:13px;padding:9px 12px;width:100%;outline:none;transition:border-color 0.15s;
}
.field-group input:focus,.field-group select:focus{border-color:var(--teal);}
.field-group .field-hint{font-size:11px;color:var(--fg-faint);line-height:1.5;}
.platform-checks{display:flex;gap:10px;}
.plat-check{
  flex:1;padding:10px 12px;border-radius:var(--radius-sm);
  border:1px solid var(--border2);background:var(--surface2);
  cursor:pointer;transition:all 0.15s;display:flex;align-items:center;gap:8px;
}
.plat-check:hover{background:var(--surface3);}
.plat-check.active{background:var(--teal-bg);border-color:rgba(42,122,111,0.3);}
.plat-check input{accent-color:var(--teal);width:14px;height:14px;}
.plat-check span{font-size:13px;font-weight:500;}
.status-row{
  display:flex;align-items:center;gap:8px;
  padding:10px 12px;border-radius:var(--radius-sm);
  background:var(--surface2);border:1px solid var(--border);
  font-size:12px;
}
.status-row .sr-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
.status-row.ok .sr-dot{background:var(--teal);}
.status-row.err .sr-dot{background:var(--rust);}
.status-row.idle .sr-dot{background:var(--fg-faint);}

/* PROVIDER TOGGLE */
.provider-toggle{display:flex;flex-direction:column;gap:6px;}
.provider-opt{
  display:flex;align-items:center;gap:12px;
  padding:12px 14px;border-radius:var(--radius-sm);
  border:1px solid var(--border2);background:var(--surface2);
  cursor:pointer;transition:all 0.15s;
}
.provider-opt:hover{background:var(--surface3);}
.provider-opt.active{background:var(--cream);border-color:var(--amber);box-shadow:0 0 0 2px rgba(201,122,26,0.1);}
.po-icon{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;}
.po-title{font-size:13px;font-weight:600;margin-bottom:2px;}
.po-desc{font-size:11px;color:var(--fg-muted);}
.po-check{margin-left:auto;font-size:14px;color:var(--amber);font-weight:700;}

/* MODEL TASK GRID */
.model-task-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px;}
.mtask-card{background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:10px 12px;}
.mtask-label{font-size:10px;font-weight:600;letter-spacing:0.7px;text-transform:uppercase;color:var(--fg-faint);margin-bottom:6px;}
.mtask-card select{background:var(--cream);border:1px solid var(--border2);border-radius:var(--radius-sm);padding:6px 8px;font-size:12px;width:100%;color:var(--ink);font-family:'Archivo',sans-serif;outline:none;}
code{background:var(--surface3);padding:1px 5px;border-radius:3px;font-size:11px;font-family:monospace;}

/* ── SCHEDULE SETTINGS MODAL ── */
.day-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-bottom:4px;}
.day-btn{
  padding:8px 4px;border-radius:var(--radius-sm);border:1px solid var(--border2);
  background:var(--surface2);font-size:11px;font-weight:600;text-align:center;
  cursor:pointer;transition:all 0.15s;color:var(--fg-muted);
  font-family:'Archivo',sans-serif;
}
.day-btn:hover{background:var(--surface3);color:var(--ink);}
.day-btn.selected{background:var(--teal-bg);border-color:rgba(42,122,111,0.35);color:var(--teal);}
.day-btn.weekend{border-style:dashed;}
.day-btn.weekend.selected{background:rgba(201,122,26,0.1);border-color:rgba(201,122,26,0.35);color:var(--amber);border-style:solid;}

.slot-list{display:flex;flex-direction:column;gap:8px;margin-top:2px;}
.slot-row{
  display:grid;grid-template-columns:120px 1fr 1fr 36px;
  align-items:center;gap:8px;
  padding:10px 12px;border-radius:var(--radius-sm);
  background:var(--surface2);border:1px solid var(--border);
}
.slot-row.inactive{opacity:0.4;}
.slot-day-label{font-size:12px;font-weight:600;color:var(--ink2);}
.slot-day-label .slot-badge{
  font-size:9px;font-weight:700;padding:1px 5px;border-radius:8px;
  margin-left:4px;background:var(--amber-bg);color:var(--amber);
}
.slot-time-input{
  background:var(--cream);border:1px solid var(--border2);
  border-radius:var(--radius-sm);color:var(--ink);
  font-family:'Archivo',sans-serif;font-size:12px;
  padding:6px 8px;width:100%;outline:none;
}
.slot-time-input:focus{border-color:var(--teal);}
.slot-plat-select{
  background:var(--cream);border:1px solid var(--border2);
  border-radius:var(--radius-sm);color:var(--ink);
  font-family:'Archivo',sans-serif;font-size:11px;
  padding:6px 8px;width:100%;outline:none;cursor:pointer;
}
.slot-remove{
  width:28px;height:28px;border-radius:6px;border:1px solid var(--border2);
  background:none;cursor:pointer;font-size:14px;color:var(--fg-faint);
  display:flex;align-items:center;justify-content:center;
  transition:all 0.15s;font-family:'Archivo',sans-serif;
}
.slot-remove:hover{background:var(--red-bg,rgba(180,60,42,0.08));color:var(--rust);border-color:rgba(184,76,42,0.2);}
.cron-preview{
  background:var(--ink2);color:#c8e8e4;border-radius:var(--radius-sm);
  padding:12px 14px;font-family:monospace;font-size:11px;line-height:1.8;
  margin-top:2px;white-space:pre;overflow-x:auto;
}
.add-slot-btn{
  width:100%;padding:8px;border-radius:var(--radius-sm);
  background:none;border:1px dashed var(--border3);
  color:var(--fg-muted);font-size:12px;font-weight:500;
  font-family:'Archivo',sans-serif;cursor:pointer;transition:all 0.15s;
  margin-top:4px;
}
.add-slot-btn:hover{background:var(--surface2);color:var(--ink);border-style:solid;}
.sched-status-row{
  display:flex;align-items:center;gap:8px;padding:9px 12px;
  border-radius:var(--radius-sm);background:var(--surface2);
  border:1px solid var(--border);font-size:12px;margin-top:2px;
}
.sched-status-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;background:var(--fg-faint);}
.sched-status-row.ok .sched-status-dot{background:var(--teal);}
.sched-status-row.err .sched-status-dot{background:var(--rust);}
.sched-status-row.idle .sched-status-dot{background:var(--fg-faint);}

/* ── SEND PANEL (inline in action bar) ── */
.n8n-send-panel{
  display:flex;align-items:center;gap:8px;
  padding:8px 12px;border-radius:var(--radius-sm);
  background:var(--teal-bg);border:1px solid rgba(42,122,111,0.2);
  font-size:12px;color:var(--teal);
}
.n8n-send-panel strong{font-weight:600;}

/* ── PAYLOAD PREVIEW ── */
.payload-box{
  background:var(--ink2);color:#c8e8e4;
  border-radius:var(--radius-sm);padding:14px;
  font-family:monospace;font-size:11px;line-height:1.7;
  max-height:180px;overflow-y:auto;white-space:pre-wrap;
  word-break:break-all;
}

/* ── MAIN LAYOUT ── */
.shell{display:flex;flex:1;overflow:hidden;height:calc(100vh - 54px);}

/* ── SIDEBAR ── */
.sidebar{
  width:248px;flex-shrink:0;
  border-right:1px solid var(--border2);
  background:var(--cream);
  display:flex;flex-direction:column;
  overflow:hidden;
}
.sidebar-top{
  padding:16px 16px 12px;
  border-bottom:1px solid var(--border);
}
.week-label{
  font-size:10px;font-weight:600;letter-spacing:1px;text-transform:uppercase;
  color:var(--fg-faint);margin-bottom:10px;
}
.optimal-schedule{display:flex;flex-direction:column;gap:5px;}
.sched-day{
  display:flex;align-items:center;justify-content:space-between;
  padding:8px 10px;border-radius:var(--radius-sm);
  background:var(--surface2);border:1px solid var(--border);
  cursor:pointer;transition:all 0.15s;
}
.sched-day:hover{background:var(--surface3);}
.sched-day.today{background:var(--rust-bg);border-color:rgba(184,76,42,0.25);}
.sched-day .day-name{font-size:12px;font-weight:600;color:var(--ink2);}
.sched-day .day-time{font-size:11px;color:var(--fg-muted);}
.sched-day .day-platform{display:flex;gap:4px;}
.plat-pill{font-size:9px;font-weight:700;padding:2px 6px;border-radius:10px;letter-spacing:0.3px;}
.plat-ig{background:var(--rust-lt);color:var(--rust);}
.plat-fb{background:var(--teal-lt);color:var(--teal);}

.sidebar-scroll{flex:1;overflow-y:auto;padding:12px 16px;}
.s-section{font-size:10px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--fg-faint);margin:12px 0 8px;}
.queue-item{
  display:flex;align-items:flex-start;gap:9px;
  padding:9px 10px;border-radius:var(--radius-sm);
  cursor:pointer;transition:background 0.12s;
  border:1px solid transparent;margin-bottom:4px;
}
.queue-item:hover{background:var(--surface2);}
.queue-item.active{background:var(--surface3);border-color:var(--border2);}
.q-thumb{
  width:36px;height:36px;border-radius:5px;flex-shrink:0;
  background:var(--surface3);display:flex;align-items:center;justify-content:center;
  font-size:16px;
}
.q-meta{flex:1;min-width:0;}
.q-title{font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.q-sub{font-size:10px;color:var(--fg-faint);margin-top:2px;}
.q-badge{
  font-size:9px;font-weight:700;padding:2px 7px;border-radius:10px;
  white-space:nowrap;letter-spacing:0.3px;
}
.q-pending{background:var(--rust-bg);color:var(--rust);}
.q-scheduled{background:var(--teal-bg);color:var(--teal);}
.q-draft{background:var(--surface3);color:var(--fg-muted);}
.q-posted{background:rgba(42,122,111,0.15);color:var(--teal);}

.add-btn{
  width:100%;padding:9px;border-radius:var(--radius-sm);
  background:none;border:1px dashed var(--border3);
  color:var(--fg-muted);font-size:12px;font-weight:500;
  font-family:'Archivo',sans-serif;cursor:pointer;transition:all 0.15s;
  margin-top:4px;
}
.add-btn:hover{background:var(--surface2);color:var(--ink);border-style:solid;}

/* ── MAIN PANEL ── */
.main-panel{flex:1;overflow:hidden;display:flex;flex-direction:column;}

/* ── COMPOSE ── */
#view-compose{flex:1;display:flex;flex-direction:column;overflow:hidden;}
.compose-body{flex:1;overflow-y:auto;display:flex;gap:0;}
.compose-left{flex:1;min-width:0;padding:24px 20px 24px 24px;display:flex;flex-direction:column;gap:16px;}
.compose-right{width:292px;flex-shrink:0;padding:24px 24px 24px 0;display:flex;flex-direction:column;gap:14px;}

/* CARDS */
.card{
  background:var(--cream);border:1px solid var(--border2);
  border-radius:var(--radius);overflow:hidden;
}
.card-head{
  padding:11px 16px;border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
}
.card-head h3{font-size:12px;font-weight:600;letter-spacing:0.2px;}
.card-body{padding:14px 16px;}

/* UPLOAD */
.upload-zone{
  border:1.5px dashed var(--border3);border-radius:var(--radius);
  height:260px;display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:8px;
  cursor:pointer;transition:all 0.2s;background:var(--cream);
  position:relative;overflow:hidden;
}
.upload-zone:hover{border-color:var(--rust);background:var(--rust-bg);}
.upload-icon-big{font-size:36px;opacity:0.35;}
.upload-hint{font-size:12px;color:var(--fg-muted);text-align:center;line-height:1.5;}
.upload-zone input{position:absolute;inset:0;opacity:0;cursor:pointer;}
#previewImg{width:100%;height:100%;object-fit:cover;display:none;position:absolute;inset:0;}

/* CAPTION */
textarea{
  width:100%;background:transparent;border:none;resize:none;
  font-family:'Archivo',sans-serif;font-size:13.5px;color:var(--ink);
  line-height:1.7;outline:none;min-height:110px;
}
textarea::placeholder{color:var(--fg-faint);}
.char-count{font-size:11px;color:var(--fg-faint);text-align:right;padding:4px 16px 10px;}
.tone-row{
  display:flex;gap:5px;flex-wrap:wrap;
  padding:10px 16px;border-top:1px solid var(--border);
  align-items:center;
}
.tone-label{font-size:10px;font-weight:600;letter-spacing:0.8px;text-transform:uppercase;color:var(--fg-faint);margin-right:4px;}
.tone-btn{
  font-size:11px;font-weight:500;padding:4px 10px;border-radius:20px;
  border:1px solid var(--border2);background:none;color:var(--fg-muted);
  cursor:pointer;font-family:'Archivo',sans-serif;transition:all 0.15s;
}
.tone-btn:hover,.tone-btn.active{background:var(--rust-bg);color:var(--rust);border-color:rgba(184,76,42,0.3);}

/* HASHTAGS */
.tag-cloud{display:flex;flex-wrap:wrap;gap:6px;padding:12px 16px;}
.htag{
  font-size:11px;font-weight:500;padding:4px 10px;border-radius:20px;
  background:var(--surface2);color:var(--ink2);border:1px solid var(--border2);
  cursor:pointer;transition:all 0.15s;
}
.htag:hover{background:var(--surface3);}
.htag.portrait{background:var(--rust-bg);color:var(--rust);border-color:rgba(184,76,42,0.2);}
.htag.street{background:var(--amber-bg);color:var(--amber);border-color:rgba(201,122,26,0.2);}
.htag.removed{background:var(--surface2);color:var(--fg-faint);text-decoration:line-through;opacity:0.5;}
.htag-input{
  background:var(--surface2);border:1px solid var(--border2);border-radius:var(--radius-sm);
  color:var(--ink);font-family:'Archivo',sans-serif;font-size:12px;
  padding:7px 12px;width:100%;outline:none;margin:0 16px 14px;width:calc(100% - 32px);
  transition:border-color 0.15s;
}
.htag-input:focus{border-color:var(--rust);}

/* BUTTONS */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:6px;
  padding:8px 16px;border-radius:var(--radius-sm);font-size:12px;font-weight:600;
  cursor:pointer;transition:all 0.18s;border:none;font-family:'Archivo',sans-serif;
  white-space:nowrap;letter-spacing:0.2px;
}
.btn-ai{background:var(--rust-bg);color:var(--rust);border:1px solid rgba(184,76,42,0.2);}
.btn-ai:hover{background:rgba(184,76,42,0.14);}
.btn-primary{background:var(--rust);color:#fff;}
.btn-primary:hover{background:#a0401f;}
.btn-primary:disabled{opacity:0.4;cursor:not-allowed;}
.btn-ghost{background:none;color:var(--fg-muted);border:1px solid var(--border2);}
.btn-ghost:hover{background:var(--surface2);color:var(--ink);}
.btn-teal{background:var(--teal-bg);color:var(--teal);border:1px solid rgba(42,122,111,0.2);}
.btn-teal:hover{background:rgba(42,122,111,0.14);}
.btn-sm{padding:5px 11px;font-size:11px;}

/* AI LOADING */
@keyframes aiPulse{0%,100%{opacity:0.3}50%{opacity:1}}
.ai-dots{display:flex;gap:4px;align-items:center;}
.ai-dot{width:5px;height:5px;border-radius:50%;background:var(--rust);animation:aiPulse 1.1s infinite;}
.ai-dot:nth-child(2){animation-delay:0.18s;}
.ai-dot:nth-child(3){animation-delay:0.36s;}
.ai-spinner{display:none;align-items:center;gap:8px;padding:6px 0;}
.ai-spinner.active{display:flex;}
.ai-spinner span{font-size:11px;color:var(--fg-muted);}

/* SCHEDULE WIDGET */
.sched-widget{
  background:var(--cream);border:1px solid var(--border2);
  border-radius:var(--radius);padding:16px;
}
.sched-widget .sw-label{font-size:10px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--fg-faint);margin-bottom:8px;}
.sched-time{
  font-family:'Playfair Display',serif;font-size:32px;
  color:var(--ink);line-height:1;
}
.sched-datestr{font-size:12px;color:var(--fg-muted);margin-top:4px;margin-bottom:12px;}
input[type=datetime-local]{
  background:var(--surface2);border:1px solid var(--border2);
  border-radius:var(--radius-sm);color:var(--ink);
  font-family:'Archivo',sans-serif;font-size:12px;
  padding:8px 10px;width:100%;outline:none;
  transition:border-color 0.15s;
}
input[type=datetime-local]:focus{border-color:var(--rust);}
.opt-slots{display:flex;flex-direction:column;gap:5px;margin-top:10px;}
.opt-slot{
  display:flex;align-items:center;justify-content:space-between;
  padding:7px 10px;border-radius:var(--radius-sm);
  background:var(--surface2);border:1px solid var(--border);
  cursor:pointer;transition:all 0.15s;
}
.opt-slot:hover{background:var(--surface3);border-color:var(--border2);}
.opt-slot.best{background:var(--rust-bg);border-color:rgba(184,76,42,0.2);}
.opt-slot .os-day{font-size:12px;font-weight:600;}
.opt-slot .os-time{font-size:11px;color:var(--fg-muted);}
.opt-slot .os-score{font-size:10px;font-weight:700;color:var(--rust);}

/* PREVIEW */
.preview-frame{
  background:var(--cream);border:1px solid var(--border2);
  border-radius:var(--radius);overflow:hidden;
}
.prev-header{
  display:flex;align-items:center;gap:9px;padding:10px 13px;
  border-bottom:1px solid var(--border);
}
.prev-avatar{
  width:30px;height:30px;border-radius:50%;
  background:linear-gradient(135deg,var(--rust),#d4703a);
  display:flex;align-items:center;justify-content:center;
  font-size:11px;font-weight:700;color:#fff;flex-shrink:0;
}
.prev-name{font-size:12px;font-weight:600;}
.prev-handle{font-size:10px;color:var(--fg-faint);}
.prev-img-area{
  height:150px;background:var(--surface3);
  display:flex;align-items:center;justify-content:center;
  position:relative;overflow:hidden;
}
.prev-img-area span{font-size:11px;color:var(--fg-faint);}
#prevImgPreview{display:none;position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
.prev-caption{
  padding:11px 13px;font-size:12px;color:var(--ink2);line-height:1.6;
  max-height:90px;overflow-y:auto;border-top:1px solid var(--border);
}
.prev-caption .ptag{color:var(--rust);}
.prev-platform-tabs{display:flex;border-bottom:1px solid var(--border);}
.ptab{
  flex:1;padding:7px;text-align:center;font-size:10px;font-weight:600;
  cursor:pointer;transition:all 0.15s;color:var(--fg-muted);
  border-bottom:2px solid transparent;
}
.ptab.active{color:var(--rust);border-bottom-color:var(--rust);}

/* CHECKLIST */
.check-item{
  display:flex;align-items:center;gap:10px;
  padding:8px 0;border-bottom:1px solid var(--border);
  font-size:12px;color:var(--ink2);cursor:pointer;
}
.check-item:last-child{border-bottom:none;}
.check-item input[type=checkbox]{accent-color:var(--rust);width:14px;height:14px;cursor:pointer;}

/* ACTION BAR */
.action-bar{
  padding:13px 24px;border-top:1px solid var(--border2);
  display:flex;align-items:center;gap:10px;
  background:var(--cream);flex-shrink:0;
}
.spacer{flex:1;}

/* ── SCHEDULE VIEW ── */
#view-schedule{display:none;flex:1;overflow-y:auto;padding:28px;}
.week-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:10px;margin-top:20px;}
.wday-head{text-align:center;font-size:10px;font-weight:600;letter-spacing:0.8px;text-transform:uppercase;color:var(--fg-faint);padding:6px 0;}
.wday-cell{
  min-height:120px;background:var(--cream);border:1px solid var(--border2);
  border-radius:var(--radius);padding:10px 8px;
}
.wday-cell.optimal{border-color:rgba(184,76,42,0.35);background:var(--rust-bg);}
.wday-cell.today-cell{border-color:var(--rust);}
.wday-num{font-size:12px;font-weight:600;margin-bottom:7px;}
.wday-cell.optimal .wday-num{color:var(--rust);}
.sched-post{
  font-size:10px;font-weight:600;padding:4px 7px;border-radius:4px;
  margin-bottom:4px;line-height:1.3;
}
.sched-post.ig{background:var(--rust-lt);color:var(--rust);}
.sched-post.fb{background:var(--teal-lt);color:var(--teal);}
.sched-post.both{background:var(--amber-bg);color:var(--amber);}
.optimal-banner{
  background:var(--rust-bg);border:1px solid rgba(184,76,42,0.2);
  border-radius:var(--radius);padding:14px 18px;margin-bottom:20px;
  font-size:13px;color:var(--ink2);line-height:1.6;
}
.optimal-banner strong{color:var(--rust);}

/* ── IDEAS VIEW ── */
#view-ideas{display:none;flex:1;overflow-y:auto;padding:28px;}
.ideas-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:20px;gap:16px;}
.ideas-intro{font-size:13px;color:var(--fg-muted);max-width:480px;line-height:1.6;}
.ideas-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.idea-card{
  background:var(--cream);border:1px solid var(--border2);border-radius:var(--radius);
  padding:16px;cursor:pointer;transition:all 0.18s;
}
.idea-card:hover{border-color:var(--rust);transform:translateY(-1px);box-shadow:var(--shadow);}
.idea-type{
  display:inline-flex;align-items:center;gap:5px;
  font-size:10px;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;
  margin-bottom:8px;
}
.type-portrait{color:var(--rust);}
.type-street{color:var(--amber);}
.type-reel{color:var(--teal);}
.type-story{color:#7a5ea0;}
.idea-title{font-family:'Playfair Display',serif;font-size:16px;margin-bottom:6px;line-height:1.3;}
.idea-desc{font-size:12px;color:var(--fg-muted);line-height:1.55;margin-bottom:10px;}
.idea-footer{display:flex;align-items:center;justify-content:space-between;}
.idea-meta-tags{display:flex;gap:5px;flex-wrap:wrap;}
.idea-meta-tag{font-size:10px;padding:2px 7px;border-radius:10px;background:var(--surface2);color:var(--fg-muted);font-weight:600;}
.idea-use-btn{font-size:11px;font-weight:600;color:var(--rust);background:none;border:none;cursor:pointer;font-family:'Archivo',sans-serif;}
.idea-use-btn:hover{text-decoration:underline;}
.ideas-loading{display:none;align-items:center;gap:10px;padding:20px 0;font-size:13px;color:var(--fg-muted);}

/* ── REELS VIEW ── */
#view-reels{display:none;flex:1;overflow-y:auto;padding:28px;}
.reels-layout{display:grid;grid-template-columns:1fr 360px;gap:20px;align-items:start;}
.reel-concept{
  background:var(--cream);border:1px solid var(--border2);border-radius:var(--radius);
  padding:20px;
}
.reel-script-output{
  background:var(--surface2);border-radius:var(--radius-sm);padding:16px;
  font-size:13px;color:var(--ink2);line-height:1.75;min-height:200px;
  white-space:pre-wrap;font-family:'Archivo',sans-serif;
  border:1px solid var(--border);
}
.reel-script-output.empty{
  display:flex;align-items:center;justify-content:center;
  color:var(--fg-faint);font-style:italic;
}
.format-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px;}
.format-card{
  padding:10px 12px;border-radius:var(--radius-sm);border:1px solid var(--border2);
  background:var(--surface2);cursor:pointer;transition:all 0.15s;
}
.format-card:hover,.format-card.active{background:var(--rust-bg);border-color:rgba(184,76,42,0.3);}
.format-card .fc-title{font-size:12px;font-weight:600;margin-bottom:2px;}
.format-card .fc-desc{font-size:11px;color:var(--fg-muted);}
.format-card.active .fc-title{color:var(--rust);}
select{
  width:100%;background:var(--surface2);border:1px solid var(--border2);
  border-radius:var(--radius-sm);color:var(--ink);font-family:'Archivo',sans-serif;
  font-size:12px;padding:8px 10px;outline:none;cursor:pointer;
}

/* NOTIFICATIONS */
.toast{
  position:fixed;bottom:24px;right:24px;z-index:999;
  background:var(--ink2);color:#fff;
  border-radius:var(--radius);padding:12px 18px;
  font-size:13px;font-weight:500;display:flex;align-items:center;gap:9px;
  transform:translateY(16px);opacity:0;transition:all 0.25s;pointer-events:none;
  box-shadow:0 8px 32px rgba(0,0,0,0.25);
}
.toast.show{transform:translateY(0);opacity:1;}

/* SCROLLBAR */
::-webkit-scrollbar{width:4px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:var(--surface4);border-radius:4px;}

/* DIVIDER */
.divider{height:1px;background:var(--border);margin:4px 0;}

/* FIELD LABEL */
.field-label{font-size:10px;font-weight:600;letter-spacing:0.8px;text-transform:uppercase;color:var(--fg-faint);margin-bottom:8px;}

input[type=text]{
  width:100%;background:var(--surface2);border:1px solid var(--border2);
  border-radius:var(--radius-sm);color:var(--ink);font-family:'Archivo',sans-serif;
  font-size:12px;padding:8px 10px;outline:none;transition:border-color 0.15s;
}
input[type=text]:focus{border-color:var(--rust);}
</style>

    return;
  }
  cloud.innerHTML = tags.map(t =>
    `<span class="htag ${genre||''}" onclick="removeTag(this,'${t}')">${t}</span>`
  ).join('');
  document.getElementById('hashCount').textContent = `(${tags.length}/30)`;
}


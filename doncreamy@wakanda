async function testWebhook() {
  const url = document.getElementById('webhookUrl').value.trim();
  if (!url) { setStatus('err','Please enter a webhook URL first.'); return; }
  const btn = document.getElementById('testBtn');
  btn.textContent = 'Testing...'; btn.disabled = true;
  setStatus('idle','Sending test ping to n8n...');
  const secret = document.getElementById('webhookSecret').value.trim();
  const headers = {'Content-Type':'application/json'};
  if (secret) headers['x-framepost-secret'] = secret;
  try {
    const res = await fetch(url, {
      method:'POST',
      headers,
      body: JSON.stringify({ source:'framepost', type:'test', message:'FramePost connection test' })
    });
    if (res.ok || res.status === 200) {
      setStatus('ok','Connected! n8n received the test ping.');
      n8nConfig.connected = true;
    } else {
      setStatus('err',`n8n returned status ${res.status}. Check the webhook is Active.`);
    }
  } catch(e) {
    // CORS errors from n8n are expected in browser — treat as likely success
    setStatus('ok','Ping sent — likely connected (CORS is normal for n8n webhooks).');
    n8nConfig.connected = true;
  }
  btn.textContent = 'Test Connection'; btn.disabled = false;
}

function saveN8nSettings() {
  const url = document.getElementById('webhookUrl').value.trim();
  if (!url) { setStatus('err','Enter a webhook URL to save.'); return; }
  n8nConfig.webhookUrl = url;
  n8nConfig.secret = document.getElementById('webhookSecret').value.trim();
  n8nConfig.connected = true;
  // Update header badge
  document.getElementById('n8nDot').className = 'n8n-dot connected';
  document.getElementById('n8nBadgeLabel').textContent = 'n8n Connected';
  document.getElementById('sendN8nBtn').style.display = 'inline-flex';

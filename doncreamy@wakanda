      { day:6, hour:10, minute:0,  platforms:'both' },
      { day:0, hour:11, minute:0,  platforms:'ig'   }
    ],
    daily:    [0,1,2,3,4,5,6].map(d => ({
      day: d, hour: WEEKEND.includes(d) ? 10 : 19, minute: 0, platforms: 'both'
    }))
  };
  if (!presets[name]) return;
  schedConfig.slots = presets[name];
  renderDayGrid();
  renderSlotList();
  updateCronPreview();
  toast('⏱', 'Preset applied');
}

// ── TEST + SAVE ──
async function testSchedWebhook() {
  const url = document.getElementById('schedWebhookUrl').value.trim();
  if (!url) { updateSchedStatus('err','Enter the n8n schedule webhook URL first.'); return; }
  const btn = document.getElementById('schedTestBtn');
  btn.textContent = 'Testing...'; btn.disabled = true;
  updateSchedStatus('idle','Pinging n8n...');
  try {
    const res = await fetch(url, {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ type:'test', source:'framepost' })
    });
    if (res.ok) updateSchedStatus('ok','n8n schedule webhook reachable ✓');
    else updateSchedStatus('err',`n8n returned ${res.status} — is the workflow active?`);
  } catch(e) {
    updateSchedStatus('err','Cannot reach n8n. Check pm2 list and that the workflow is active.');
  }
  btn.textContent = 'Test n8n Connection'; btn.disabled = false;
}

async function saveScheduleSettings() {
  const url = document.getElementById('schedWebhookUrl').value.trim();
  schedConfig.webhookUrl = url;
  saveSchedToStorage();
  updateSchedBadge();
  syncSidebarSchedule();

  if (!url) {
    closeScheduleSettings();
    toast('⏱','Schedule saved locally — no n8n URL set yet');
    return;
  }

  // Push cron expressions to n8n
  const sorted = [...schedConfig.slots].sort((a,b) => a.day - b.day || a.hour - b.hour);
  const payload = {
    type:   'schedule_update',
    source: 'framepost',
    slots:  sorted.map(s => ({
      day:       s.day,
      day_name:  DAY_NAMES[s.day],
      hour:      s.hour,
      minute:    s.minute,
      platforms: s.platforms,
      cron:      slotToCron(s),
      label:     slotToLabel(s)
    })),
    cron_expressions: sorted.map(s => slotToCron(s)),
    updated_at: new Date().toISOString()
  };

  try {
    const res = await fetch(url, {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify(payload)
    });
    if (res.ok) {
      updateSchedStatus('ok','Schedule pushed to n8n ✓');
      toast('⏱','Schedule saved and pushed to n8n');
    } else {
      updateSchedStatus('err',`n8n returned ${res.status}`);
      toast('!','Saved locally but n8n push failed');
    }
  } catch(e) {
    updateSchedStatus('err','Could not reach n8n — saved locally only');
    toast('⏱','Schedule saved locally');
  }
  closeScheduleSettings();
}

function updateSchedStatus(type, msg) {
  const row = document.getElementById('schedStatusRow');
  if (!row) return;
  row.className = 'sched-status-row ' + type;
  document.getElementById('schedStatusText').textContent = msg || '';
}

// ── INIT ──
loadPost(0);
updateScheduleDisplay();
syncSidebarSchedule();
setTimeout(pollDraftQueue, 1000); // slight delay so config loads first
async function pollDraftQueue() {
  if (!aiConfig.brokerUrl) return;
  // Derive queue URL from broker URL
  const queueUrl = aiConfig.brokerUrl.replace('framepost-ai','framepost-queue');
  try {
    const res = await fetch(queueUrl);
    if (!res.ok) return;
    const d = await res.json();
    if (!d.queue || d.queue.length === 0) return;
    // Inject n8n drafts into the sidebar queue
    injectN8nDrafts(d.queue);
  } catch(e) { /* silent — n8n may not be running */ }
}

function injectN8nDrafts(drafts) {
  const scroll = document.querySelector('.sidebar-scroll');
  if (!scroll) return;
  // Remove existing n8n draft items
  scroll.querySelectorAll('.queue-item[data-n8n]').forEach(el => el.remove());
  // Insert after the s-section label
  const label = scroll.querySelector('.s-section');
  drafts.slice(0, 5).forEach(draft => {
    const el = document.createElement('div');
    el.className = 'queue-item';
    el.setAttribute('data-n8n', draft.draft_id);
    el.innerHTML = `
      <div class="q-thumb">📷</div>
      <div class="q-meta">
        <div class="q-title">${draft.readable_name || 'Auto draft'}</div>
        <div class="q-sub">From Cloudinary</div>
      </div>
      <span class="q-badge q-pending">Review</span>`;
    el.onclick = () => loadN8nDraft(draft);
    label.after(el);
  });
  toast('📬', `${drafts.length} draft${drafts.length > 1 ? 's' : ''} ready to review`);
}

function loadN8nDraft(draft) {
  document.querySelectorAll('.queue-item').forEach(el => el.classList.remove('active'));
  document.querySelector(`[data-n8n="${draft.draft_id}"]`)?.classList.add('active');
  // Load caption
  document.getElementById('captionInput').value = draft.caption || '';
  // Load hashtags
  tags = draft.hashtags || [];
  renderTags();
  // Load schedule
  document.getElementById('schedInput').value = new Date().toISOString().slice(0,16);
  updateScheduleDisplay();
  updatePreview();
  updateCharCount();
  // Store image_url and public_id so sendToN8n includes them
  window._activeDraft = draft;
  // Show image preview if available
  if (draft.image_url) {
    const prev = document.getElementById('previewImg');
    prev.src = draft.image_url; prev.style.display = 'block';
    document.querySelector('.upload-icon-big').style.display = 'none';
    document.querySelector('.upload-hint').style.display = 'none';
    const pp = document.getElementById('prevImgPreview');
    pp.src = draft.image_url; pp.style.display = 'block';
    document.querySelector('.prev-img-area span').style.display = 'none';
  }
  document.getElementById('platformLabel').textContent = 'Posting to: Instagram + Facebook';
  toast('📷', 'Draft loaded — review and approve');
}

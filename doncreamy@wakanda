// ── DAY GRID ──
function renderDayGrid() {
  const activeDays = schedConfig.slots.map(s => s.day);
  document.querySelectorAll('#dayGrid .day-btn').forEach(btn => {
    const d = parseInt(btn.dataset.day);
    btn.classList.toggle('selected', activeDays.includes(d));
    btn.classList.toggle('weekend', WEEKEND.includes(d));
  });
  updateDayCountHint();
}

function toggleDay(btn) {
  const day = parseInt(btn.dataset.day);
  const existingIdx = schedConfig.slots.findIndex(s => s.day === day);
  if (existingIdx !== -1) {
    // Remove slot for this day
    schedConfig.slots.splice(existingIdx, 1);
    btn.classList.remove('selected');
  } else {
    // Add a default slot for this day — pick a sensible default time
    const defaultHour = WEEKEND.includes(day) ? 10 : 19;
    schedConfig.slots.push({ day, hour: defaultHour, minute: 0, platforms: 'both' });
    schedConfig.slots.sort((a,b) => a.day - b.day);
    btn.classList.add('selected');
  }
  updateDayCountHint();
  renderSlotList();
  updateCronPreview();
}

function updateDayCountHint() {
  const count = schedConfig.slots.length;
  const hint  = document.getElementById('dayCountHint');
  const hasWeekend = schedConfig.slots.some(s => WEEKEND.includes(s.day));
  if (count === 0) {
    hint.textContent = 'Select at least 1 day';
    hint.style.color = 'var(--rust)';
  } else if (!hasWeekend) {
    hint.textContent = `${count} day${count>1?'s':''} selected — add a weekend day for better reach`;
    hint.style.color = 'var(--amber)';
  } else {
    hint.textContent = `${count} day${count>1?'s':''} selected ✓`;
    hint.style.color = 'var(--teal)';
  }
}

// ── SLOT LIST ──
function renderSlotList() {
  const list = document.getElementById('slotList');
  list.innerHTML = '';
  if (schedConfig.slots.length === 0) {
    list.innerHTML = '<div style="font-size:12px;color:var(--fg-faint);padding:8px 0;">No slots — select a day above to add one.</div>';
    return;
  }
  const sorted = [...schedConfig.slots].sort((a,b) => a.day - b.day || a.hour - b.hour || a.minute - b.minute);
  sorted.forEach((slot, i) => {
    const isWeekend = WEEKEND.includes(slot.day);
    const timeVal   = `${String(slot.hour).padStart(2,'0')}:${String(slot.minute).padStart(2,'0')}`;
    const row = document.createElement('div');
    row.className = 'slot-row';
    row.innerHTML = `
      <div class="slot-day-label">
        ${DAY_NAMES[slot.day]}
        ${isWeekend ? '<span class="slot-badge">Weekend</span>' : ''}
      </div>
      <input type="time" class="slot-time-input" value="${timeVal}"
        onchange="updateSlotTime(${slot.day}, this.value)" title="Post time">
      <select class="slot-plat-select" onchange="updateSlotPlatform(${slot.day}, this.value)">
        <option value="both"   ${slot.platforms==='both'  ?'selected':''}>IG + Facebook</option>
        <option value="ig"     ${slot.platforms==='ig'    ?'selected':''}>Instagram only</option>
        <option value="fb"     ${slot.platforms==='fb'    ?'selected':''}>Facebook only</option>
      </select>
      <button class="slot-remove" onclick="removeSlot(${slot.day})" title="Remove this day">✕</button>`;
    list.appendChild(row);
  });
}

function updateSlotTime(day, timeVal) {
  const [h, m] = timeVal.split(':').map(Number);
  const slot = schedConfig.slots.find(s => s.day === day);
  if (slot) { slot.hour = h; slot.minute = m; }
  updateCronPreview();
  syncSidebarSchedule();
}

function updateSlotPlatform(day, val) {
  const slot = schedConfig.slots.find(s => s.day === day);
  if (slot) slot.platforms = val;
}

function removeSlot(day) {
  schedConfig.slots = schedConfig.slots.filter(s => s.day !== day);
  renderDayGrid();
  renderSlotList();
  updateCronPreview();
}

function addSlot() {
  // Find first day that doesn't have a slot yet
  const usedDays = schedConfig.slots.map(s => s.day);
  const freeDays = [1,2,3,4,5,0,6].filter(d => !usedDays.includes(d));
  if (freeDays.length === 0) { toast('!','All 7 days already have slots'); return; }
  const day = freeDays[0];
  schedConfig.slots.push({ day, hour: 19, minute: 0, platforms: 'both' });
  schedConfig.slots.sort((a,b) => a.day - b.day);
  renderDayGrid();
  renderSlotList();
  updateCronPreview();
}

// ── CRON PREVIEW ──
function slotToCron(slot) {
  return `${slot.minute} ${slot.hour} * * ${slot.day}`;
}

function slotToLabel(slot) {
  const h = slot.hour % 12 || 12;
  const ap = slot.hour >= 12 ? 'PM' : 'AM';
  const m = slot.minute ? `:${String(slot.minute).padStart(2,'0')}` : '';
  const platLabel = slot.platforms === 'both' ? 'IG + FB'
                  : slot.platforms === 'ig'   ? 'Instagram'
                  : 'Facebook';
  return `${DAY_NAMES[slot.day].padEnd(10)} ${h}${m} ${ap}  →  ${platLabel}`;
}

function updateCronPreview() {
  const box = document.getElementById('cronPreview');
  if (!schedConfig.slots.length) { box.textContent = 'No slots configured...'; return; }
  const sorted = [...schedConfig.slots].sort((a,b) => a.day - b.day || a.hour - b.hour);
  const lines = sorted.map(s => `${slotToCron(s).padEnd(16)}  # ${slotToLabel(s)}`);
  box.textContent = lines.join('\n');
}

// ── SYNC SIDEBAR ──
function syncSidebarSchedule() {
  const container = document.querySelector('.optimal-schedule');
  if (!container) return;
  const sorted = [...schedConfig.slots].sort((a,b) => a.day - b.day || a.hour - b.hour);
  container.innerHTML = sorted.map(slot => {
    const h = slot.hour % 12 || 12;
    const ap = slot.hour >= 12 ? 'PM' : 'AM';
    const m = slot.minute ? `:${String(slot.minute).padStart(2,'0')}` : '';
    const platLabel = slot.platforms === 'both' ? 'IG + FB'
                    : slot.platforms === 'ig'   ? 'IG only'
                    : 'FB only';
    const platHtml = slot.platforms !== 'fb'
      ? `<span class="plat-pill plat-ig">IG</span>` : '';
    const fbHtml = slot.platforms !== 'ig'
      ? `<span class="plat-pill plat-fb">FB</span>` : '';
    // Build a next-occurrence date for applySlot
    const now = new Date();
    const diff = (slot.day - now.getDay() + 7) % 7 || 7;
    const next = new Date(now);
    next.setDate(now.getDate() + diff);
    next.setHours(slot.hour, slot.minute, 0, 0);
    const isoVal = next.toISOString().slice(0,16);
    return `<div class="sched-day" onclick="applySlot('${isoVal}')">
      <div>
        <div class="day-name">${DAY_NAMES[slot.day]}</div>
        <div class="day-time">${h}${m} ${ap} — ${platLabel}</div>
      </div>
      <div class="day-platform">${platHtml}${fbHtml}</div>
    </div>`;
  }).join('');
}

